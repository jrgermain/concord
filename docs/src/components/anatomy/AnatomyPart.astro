---
interface Props {
  name: string;
  selector?: string;
  description?: string;
}

const { name, selector, description } = Astro.props;
---

<div class="part">
  <div class="part-box">
    <div class="part-label">
      <span class="part-name">{name}</span>
      {selector && <span class="cd-code part-selector">{selector}</span>}
      {description && <span class="part-description">{description}</span>}
    </div>
    <slot />
  </div>
</div>

<style>
  .part {
    --background-color: var(--cd-color-green-9);
    --border-color: var(--cd-color-green-8);
    --text-color: var(--cd-color-green-3);
    --code-bg-color: var(--cd-color-green-extra-transparent);

    display: flex;
    flex-direction: column;
  }

  .part .part {
    --background-color: var(--cd-color-blue-9);
    --border-color: var(--cd-color-blue-8);
    --text-color: var(--cd-color-blue-3);
    --code-bg-color: var(--cd-color-blue-extra-transparent);

    margin-block-start: var(--cd-space-3xs);
  }

  .part .part .part {
    --background-color: var(--cd-color-purple-9);
    --border-color: var(--cd-color-purple-8);
    --text-color: var(--cd-color-purple-3);
    --code-bg-color: var(--cd-color-purple-extra-transparent);
  }

  .part .part .part .part {
    --background-color: var(--cd-color-pink-9);
    --border-color: var(--cd-color-pink-8);
    --text-color: var(--cd-color-pink-3);
    --code-bg-color: var(--cd-color-pink-extra-transparent);
  }

  .part-box {
    background-color: var(--background-color);
    color: var(--text-color);
    border: var(--cd-border-s) solid var(--border-color);
    /* border-radius: var(--cd-radius-m); */
    corner-shape: squircle;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: var(--cd-space-2xs);
    gap: var(--cd-space-2xs);
  }

  .part-label {
    font-size: var(--cd-font-size-s);
    color: var(--text-color);
    display: flex;
    gap: var(--cd-space-2xs);
    justify-content: start;
    margin-inline-end: auto;
  }

  .part-name {
    font-weight: var(--cd-font-weight-bold);
  }

  .part-selector {
    position: relative;
    font-size: 0.85em;
    margin: auto;
    color: inherit;
    background-color: var(--code-bg-color);
  }

  .part-description {
    font-style: italic;
    color: inherit;
  }
</style>
