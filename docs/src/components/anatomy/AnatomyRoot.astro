---
interface Props {
  name: string;
  selector: string;
  flexDirection?: "row" | "column";
}

const { name, selector, flexDirection } = Astro.props;
---

<div>
  <h2 class="title">Anatomy</h2>
  <div class="root">
    <div class="root-label">
      <span class="root-name">{name}</span>
      <span class="cd-code root-selector">{selector}</span>
    </div>
    <div class="root-box" style={{ flexDirection }}>
      <slot />
    </div>
  </div>
</div>

<style>
  .root {
    display: flex;
    flex-direction: column;
    width: fit-content;
    color: var(--cd-color-blue-4);
    border: var(--cd-border-s) dashed var(--cd-color-border);
    padding: var(--cd-space-s);
    border-radius: var(--cd-radius-m);
    corner-shape: squircle;
  }

  .root-box {
    background-color: var(--cd-color-blue-9);
    border: var(--cd-border-s) solid var(--cd-color-blue-8);
    border-radius: var(--cd-radius-m);
    corner-shape: squircle;
    display: flex;
    padding: var(--cd-space-s);
    gap: var(--cd-space-xs);
    align-items: center;
    justify-content: stretch;
  }

  .root-label {
    font-size: var(--cd-font-size-s);
    display: flex;
    gap: var(--cd-space-xs);
    justify-content: start;
    margin-inline-end: auto;
  }

  .root-name {
    font-weight: var(--cd-font-weight-bold);
  }

  .root-selector {
    position: relative;
    bottom: 2px;
    font-size: 0.85em;
    margin: auto;
    color: inherit;
    background-color: var(--cd-color-blue-extra-transparent);
  }
</style>
