---
interface Props {
  name: string;
  value: string;
}

const { name, value } = Astro.props;
---

<label class="radio-card">
  <div class="cd-radio">
    <input type="radio" name={name} value={value} />
  </div>
  <slot />
</label>

<style>
  .cd-radio-card {
    --rc-border-color: light-dark(var(--cd-color-gray-8), var(--cd-color-border));

    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cd-space-2xs);
    border: var(--cd-border-s) solid var(--rc-border-color);
    border-radius: var(--cd-radius-m);
    box-shadow: var(--cd-shadow-s);
    padding: var(--cd-space-xs);
    cursor: pointer;
    font-family: var(--cd-font-family-body);
    font-weight: var(--cd-font-weight-semibold);
    transition-property: border-color, box-shadow;
    transition-timing-function: var(--cd-ease-default);
    transition-duration: var(--cd-duration-m);
    color: var(--cd-color-text-primary);
  }

  .cd-radio-card:has(input:focus-visible) {
    box-shadow:
      var(--cd-shadow-s),
      0 0 0 0.1em var(--rc-border-color),
      0 0 0 calc(0.2em + var(--cd-border-s)) var(--cd-color-gray-extra-transparent);
  }

  .cd-radio-card:has(input:checked) {
    border-color: var(--cd-color-brand-5);
    box-shadow:
      var(--cd-shadow-s),
      0 0 0 0.1em var(--cd-color-brand-5);
  }

  .cd-radio-card:has(input:checked:focus-visible) {
    box-shadow:
      var(--cd-shadow-s),
      0 0 0 0.1em var(--cd-color-brand-5),
      0 0 0 calc(0.2em + var(--cd-border-s)) var(--cd-color-brand-transparent);
  }

  .cd-radio {
    display: inline;
    line-height: 1;
  }
</style>
