---
interface Props {
  propName: "radius" | "border";
  propValue: string;
  squircle?: boolean;
}

const { propName, propValue, squircle = true } = Astro.props;

const fullPropName = propName === "radius" ? "border-radius" : "border-width";
const fullPropValue = `var(--cd-${propName}-${propValue})`;
---

<div
  class="box"
  style={{
    [fullPropName]: fullPropValue,
    cornerShape: squircle ? undefined : "round",
  }}
>
  {propName}-{propValue}
</div>
<style>
  .box {
    border: var(--cd-border-m) solid var(--cd-color-brand-5);
    height: 10rem;
    width: 12rem;
    font-family: var(--cd-font-family-mono);
    border-radius: var(--cd-radius-m);
    corner-shape: squircle;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--cd-color-surface-primary);
    height: "10rem";
  }
</style>
