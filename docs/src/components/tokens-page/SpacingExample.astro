---
interface Props {
  space: string;
}

const { space } = Astro.props;

let spaceDisplayName: string;
switch (space) {
  case "none":
    spaceDisplayName = "None";
    break;
  case "body-x":
    spaceDisplayName = "Body X";
    break;
  case "body-y":
    spaceDisplayName = "Body Y";
    break;
  default:
    spaceDisplayName = space.toUpperCase();
}
---

<div class="space-example-container">
  <div class="space-name-wrapper">
    <span class="space-name">{spaceDisplayName}</span>
    <span class="cd-code space-variable">--cd-space-{space}</span>
  </div>
  <div class="space-example">
    <div class="space-example-block"></div>
    <div
      class="space-example-spacer"
      style={{ width: `var(--cd-space-${space})` }}
    >
    </div>
    <div class="space-example-block"></div>
  </div>
</div>
<style>
  .space-example-container + .space-example-container {
    margin-block-start: var(--cd-space-m);
  }

  .space-name-wrapper {
    display: flex;
    align-items: center;
    gap: var(--cd-space-xs);
    margin-block-end: var(--cd-space-2xs);
    font-size: var(--cd-font-size-l);
  }

  .space-name {
    font-weight: var(--cd-font-weight-bold);
    font-family: var(--cd-font-family-heading);
  }

  .space-variable {
    font-size: var(--cd-font-size-s);
  }

  .space-example {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-block-end: var(--cd-space-s);
  }

  .space-example-block {
    display: inline-block;
    height: 1.5rem;
    width: 1.5rem;
    background-color: var(--cd-color-text-primary);
    flex: none;
    background-color: var(--cd-color-blue-5);
  }

  .space-example-block:not(:first-child) {
    background-color: var(--cd-color-red-5);
  }

  .space-example-spacer {
    display: inline-block;
    position: relative;
    height: var(--cd-border-s);
    background-color: var(--cd-color-text-primary);
    flex: none;
    margin: auto 0;
  }
</style>
