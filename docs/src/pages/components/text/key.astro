---
import ComponentDocumentation from "../../../layouts/ComponentDocumentation.astro";
import UsageExample from "../../../components/UsageExample.astro";
---

<ComponentDocumentation
  name="Key"
  description="An on-screen representation of a key on a computer keyboard."
>
  <UsageExample
    name="Basic Usage"
    description="Add the class `cd-key` to an element (typically a `kbd` element)."
    code={`
      <p class="cd-paragraph">
        To save a file in most applications, you can press <kbd class="cd-key">Ctrl</kbd> + <kbd class="cd-key">S</kbd>
        (or <kbd class="cd-key">⌘</kbd> + <kbd class="cd-key">S</kbd> on a Mac).
      </p>
    `}
  />
</ComponentDocumentation>
