---
import ComponentDocumentation from "../../../layouts/ComponentDocumentation.astro";
import UsageExample from "../../../components/UsageExample.astro";
import { trimTextPadding } from "../../../utils/trim-text-padding";
---

<ComponentDocumentation
  name="Table"
  description="A grid designed to show large amounts of information using rows and columns."
>
  <UsageExample
    name="Basic Usage"
    description="You can style a Table by adding the `cd-table` class to any `table` element."
    code={`
      <table class="cd-table">
        <thead>
          <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Job Area</th>
            <th>Job Title</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>John</td>
            <td>Johnson</td>
            <td>Analytics</td>
            <td>Data Analyst</td>
          </tr>
          <tr>
            <td>Jack</td>
            <td>Jackson</td>
            <td>Analytics</td>
            <td>Manager</td>
          </tr>
          <tr>
            <td>Robin</td>
            <td>Robinson</td>
            <td>Engineering</td>
            <td>Software Engineer</td>
          </tr>
        </tbody>
      </table>
    `}
  />
  <UsageExample
    name="Caption/Footer"
    description="The `caption` and `tfoot` elements are styled automatically."
    code={`
      <table class="cd-table">
        <caption>Sales Figures</caption>
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Gross Revenue</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Q1</td>
            <td>$1,202,133</td>
          </tr>
          <tr>
            <td>Q2</td>
            <td>$2,001,259</td>
          </tr>
          <tr>
            <td>Q3</td>
            <td>$997,673</td>
          </tr>
          <tr>
            <td>Q4</td>
            <td>$1,012,422</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td>Total</td>
            <td>$5,213,487</td>
          </tr>
        </tfoot>
      </table>
    `}
  />
  <UsageExample
    name="Caption Position"
    description="You can place the caption below the table by adding the class `cd-caption-position-bottom` to the `table` element."
    code={`
      <table class="cd-table cd-caption-position-bottom">
        <caption>Sales Figures</caption>
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Gross Revenue</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Q1</td>
            <td>$1,202,133</td>
          </tr>
          <tr>
            <td>Q2</td>
            <td>$2,001,259</td>
          </tr>
          <tr>
            <td>Q3</td>
            <td>$997,673</td>
          </tr>
          <tr>
            <td>Q4</td>
            <td>$1,012,422</td>
          </tr>
        </tbody>
      </table>
    `}
  />
  <UsageExample
    name="Subtle"
    description="You can make the styling softer by adding the class `cd-variant-subtle` to the `table` element."
    code={`
      <table class="cd-table cd-variant-subtle">
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Gross Revenue</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Q1</td>
            <td>$1,202,133</td>
          </tr>
          <tr>
            <td>Q2</td>
            <td>$2,001,259</td>
          </tr>
          <tr>
            <td>Q3</td>
            <td>$997,673</td>
          </tr>
          <tr>
            <td>Q4</td>
            <td>$1,012,422</td>
          </tr>
        </tbody>
      </table>
    `}
  />
  <UsageExample
    name="Spacing"
    description={trimTextPadding(`
      You can make a Table more compact by adding the class \`cd-spacing-dense\` or more spread out with the class \`cd-spacing-sparse\`.

      To further customize the spacing, you can set the \`--cd-table-spacing\`
      CSS variable on the Table element. The value of this variable _must_ be
      a unitless number. A value of \`1\` corresponds to the default density.
    `)}
    code={`
      <table class="cd-table cd-spacing-dense">
        <caption>Dense</caption>
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Gross Revenue</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Q1</td>
            <td>$1,202,133</td>
          </tr>
          <tr>
            <td>Q2</td>
            <td>$2,001,259</td>
          </tr>
          <tr>
            <td>Q3</td>
            <td>$997,673</td>
          </tr>
          <tr>
            <td>Q4</td>
            <td>$1,012,422</td>
          </tr>
        </tbody>
      </table>
      <table class="cd-table cd-spacing-sparse">
        <caption>Sparse</caption>
        <thead>
          <tr>
            <th>Quarter</th>
            <th>Gross Revenue</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Q1</td>
            <td>$1,202,133</td>
          </tr>
          <tr>
            <td>Q2</td>
            <td>$2,001,259</td>
          </tr>
          <tr>
            <td>Q3</td>
            <td>$997,673</td>
          </tr>
          <tr>
            <td>Q4</td>
            <td>$1,012,422</td>
          </tr>
        </tbody>
      </table>
    `}
  />
</ComponentDocumentation>
