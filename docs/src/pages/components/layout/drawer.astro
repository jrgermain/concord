  />
  <UsageExample
    name="Dismiss Button"
    description={trimTextPadding(`
      You can add a close button to the header of the Drawer by creating a
      \`button\` element with the class \`cd-dismiss-button\`. The close
      button should call the \`close\` method on the \`dialog\` element when
      clicked, or use the \`command\` and \`commandfor\` attributes.
    `)}
    code={`
      <button class="cd-button" command="show-modal" commandfor="drawer-3">
        Open Drawer
      </button>

      <dialog id="drawer-3" class="cd-drawer cd-side-left cd-size-small" aria-labelledby="drawer-3-title">
