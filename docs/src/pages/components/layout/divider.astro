---
import ComponentDocumentation from "../../../layouts/ComponentDocumentation.astro";
import UsageExample from "../../../components/UsageExample.astro";
import { trimTextPadding } from "../../../utils/trim-text-padding";
---

<ComponentDocumentation
  name="Divider"
  description="An element designed to visually separate or partition others."
>
  <UsageExample
    name="Defaults"
    description="To create a Divider, create an element with the class `divider`."
    code={`
      <p>Some content</p>
      <hr class="divider"/>
      <p>More content</p>
    `}
    outputWrapperClass="stack vertical no-gap"
  />

  <UsageExample
    name="Orientation"
    description="You can change the direction of a Divider by adding the classes `horizontal` (default) or `vertical`."
    code={`
      <p>Some content</p>
      <hr class="divider vertical"/>
      <p>More content</p>
    `}
    outputWrapperClass="stack horizontal no-gap"
  />

  <UsageExample
    name="Thickness"
    description={trimTextPadding(`
      To make the Divider thicker, add the class \`thick\` (to make it a little thicker) or \`thicker\` (to make it significantly thicker).

      For fine-grained control over the line thickness, you can set the \`--divider-thickness\`
      CSS variable on the Divider element. The value of this variable _must_ be a valid line width
      (e.g., \`1px\`, \`0.1rem\`, \`var(--border-m)\`).
    `)}
    code={`
      <p>Thin (default)</p>
      <hr class="divider"/>
      <p>Thick</p>
      <hr class="divider thick"/>
      <p>Thicker</p>
      <hr class="divider thicker"/>
      <p>Custom (0.2rem)</p>
      <hr class="divider" style="--divider-thickness: 0.2rem;"/>
    `}
    outputWrapperClass="stack vertical no-gap"
  />

  <UsageExample
    name="Pattern"
    description="You can change the **pattern** of a Divider by adding the classes `dashed` or `dotted`."
    code={`
      <p>Some content</p>
      <hr class="divider dashed"/>
      <p>More content</p>
      <hr class="divider dotted"/>
      <p>Even more content</p>
    `}
    outputWrapperClass="stack vertical no-gap"
  />

  <UsageExample
    name="Visibility"
    description="To add space between elements without a visible line, create a Divider with the class `invisible`."
    code={`
      <p>Some content</p>
      <hr class="divider invisible"/>
      <p>More content</p>
    `}
    outputWrapperClass="stack vertical no-gap"
  />

  <UsageExample
    name="Removing Margin"
    description="To remove the default margin around a Divider, add the class `no-margin`."
    code={`
      <p>Some content</p>
      <hr class="divider no-margin"/>
      <p>More content</p>
    `}
    outputWrapperClass=""
  />

  <UsageExample
    name="Customizing Margin"
    description="For fine-grained control over the margin on either side of the Divider, you can set
    the \`--divider-spacing\` CSS variable on the Divider element. The value of this variable _must_
    be a valid size (e.g., \`1rem\`, \`var(--space-l)\`)."
    code={`
      <p>Some content</p>
      <hr class="divider" style="--divider-spacing: 1rem;"/>
      <p>More content</p>
    `}
    outputWrapperClass=""
  />
</ComponentDocumentation>
