---
import ComponentDocumentation from "../../../layouts/ComponentDocumentation.astro";
import UsageExample from "../../../components/UsageExample.astro";
import { trimTextPadding } from "../../../utils/trim-text-padding";
---

<ComponentDocumentation
  name="Fieldset"
  description="A group of related form fields."
>
  <UsageExample
    name="Basic Usage"
    description={trimTextPadding(`
      You can use a \`fieldset\` element with a corresponding \`legend\` to
      define a group of related input fields.
      
      To style a Fieldset, give the \`fieldset\` element the class \`cd-fieldset\`.
      Inside this element should be a \`legend\` element that describes it.
      After the legend, create a \`div\` with the class \`cd-fieldset-content\` and
      place all of the fields inside it.
    `)}
    code={`
      <fieldset class="cd-fieldset">
        <legend>Home Address</legend>
        <div class="cd-fieldset-content">
          <label class="cd-field">
            Street Address
            <input type="text" />
          </label>
          <label class="cd-field">
            City
            <input type="text" />
          </label>
          <label class="cd-field">
            State
            <input type="text" />
          </label>
          <label class="cd-field">
            ZIP Code
            <input type="text" />
          </label>
        </div>
      </fieldset>
    `}
    outputWrapperClass="cd-wrap"
  />

  <UsageExample
    name="Horizontal Layout"
    description={trimTextPadding(`
      The fields will be stacked vertically by default. To display them in a
      single row, add the class \`cd-orientation-horizontal\` to the \`fieldset\` element.
    `)}
    code={`
      <fieldset class="cd-fieldset cd-orientation-horizontal">
        <legend>Deposit Amount</legend>
        <div class="cd-fieldset-content">
          <label class="cd-field">
            Amount
            <input type="number" step="0.01" />
          </label>
          <label class="cd-field">
            Currency
            <select>
              <option>USD</option>
              <option>EUR</option>
              <option>CHF</option>
            </select>
          </label>
        </div>
      </fieldset>
    `}
    outputWrapperClass="cd-wrap"
  />

  <UsageExample
    name="Subtle"
    description="You can remove the border and background from a Fieldset by adding the class `cd-variant-subtle` to the `fieldset` element."
    code={`
      <fieldset class="cd-fieldset cd-orientation-horizontal cd-variant-subtle">
        <legend>Deposit Amount</legend>
        <div class="cd-fieldset-content">
          <label class="cd-field">
            Amount
            <input type="number" step="0.01" />
          </label>
          <label class="cd-field">
            Currency
            <select>
              <option>USD</option>
              <option>EUR</option>
              <option>CHF</option>
            </select>
          </label>
        </div>
      </fieldset>
    `}
    outputWrapperClass="cd-wrap"
  />

  <UsageExample
    name="Compact"
    description="You can make a Fieldset more compact by adding the class `cd-is-compact` to the `fieldset` element. This also affects all child Field components."
    code={`
      <fieldset class="cd-fieldset cd-is-compact">
        <legend>Instant Transfer</legend>
        <div class="cd-fieldset-content">
          <label class="cd-field">
            Amount
            <div class="cd-field-input-group">
              <span class="cd-field-prefix">$</span>
              <input type="number" step="0.01" value="100.00" />
              <span class="cd-field-suffix">USD</span>
            </div>
          </label>
          <label class="cd-field">
            Source Account
            <select>
              <option>Interest Checking</option>
              <option>Relationship Savings</option>
            </select>
          </label>
          <label class="cd-field">
            Destination Account
            <select>
              <option disabled>Interest Checking</option>
              <option>Relationship Savings</option>
            </select>
          </label>

          </div>
      </fieldset>

      <fieldset class="cd-fieldset cd-orientation-horizontal cd-is-compact">
        <legend>Deposit Amount</legend>
        <div class="cd-fieldset-content">
          <label class="cd-field">
            Amount
            <div class="cd-field-input-group">
              <span class="cd-field-prefix">$</span>
              <input type="number" step="0.01" />
              <span class="cd-field-suffix">USD</span>
            </div>
          </label>
          <label class="cd-field">
            Currency
            <select>
              <option>USD</option>
              <option>EUR</option>
              <option>CHF</option>
            </select>
          </label>
        </div>
      </fieldset>
    `}
    outputWrapperClass="cd-wrap"
  />
</ComponentDocumentation>
